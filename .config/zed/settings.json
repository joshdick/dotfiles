// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
	"ui_font_size": 16.5,
	"buffer_font_family": "Maple Mono",
	"buffer_font_size": 16.5,
	"buffer_font_weight": 200.0,
	"buffer_line_height": {
		"custom": 1.4,
	},
	"agent_ui_font_size": 17,
	"agent_buffer_font_size": 16.5,
	"terminal": {
		"font_weight": 200.0,
		"blinking": "on",
		"font_size": 16.5,
		"cursor_shape": "bar",
	},
	"theme": {
		"mode": "dark",
		"light": "One Light",
		"dark": "Catppuccin Mocha",
	},
	"icon_theme": {
		"mode": "dark",
		"light": "Zed (Default)",
		"dark": "Zed (Default)",
	},
	"experimental.theme_overrides": {
		"players": [
			{
				"cursor": "#C1CCF1FF",
			},
		],
		// "terminal.background": "#191927FF",
		// "terminal.foreground": "#XXXXXXFF",
		// "terminal.bright_foreground": "#XXXXXXFF",
		// "terminal.dim_foreground": "#XXXXXXFF",
		// "terminal.ansi.black": "#XXXXXXFF",
		// "terminal.ansi.bright_black": "#XXXXXXFF",
		"terminal.ansi.red": "#E590A8FF",
		// "terminal.ansi.bright_red": "#XXXXXXFF",
		// "terminal.ansi.green": "#XXXXXXFF",
		// "terminal.ansi.bright_green": "#XXXXXXFF",
		// "terminal.ansi.yellow": "#XXXXXXFF",
		// "terminal.ansi.bright_yellow": "#XXXXXXFF",
		// "terminal.ansi.blue": "#XXXXXXFF",
		// "terminal.ansi.bright_blue": "#XXXXXXFF",
		"terminal.ansi.magenta": "#C5A7F2FF",
		// "terminal.ansi.bright_magenta": "#XXXXXXFF",
		"terminal.ansi.cyan": "#88CFE8FF",
		// "terminal.ansi.bright_cyan": "#XXXXXXFF",
		// "terminal.ansi.white": "#XXXXXXFF",
		// "terminal.ansi.bright_white": "#XXXXXXFF",
	},
	"languages": {
		"TypeScript": {
			"format_on_save": "off",
			"remove_trailing_whitespace_on_save": true,
			"ensure_final_newline_on_save": false,
		},
	},
	"agent_servers": {
		"claude-acp": {
			"type": "registry",
		},
	},
	"project_panel": {
		"dock": "right",
	},
	"outline_panel": {
		"dock": "right",
	},
	"collaboration_panel": {
		"dock": "right",
	},
	"agent": {
		"dock": "left",
		"favorite_models": [],
		"model_parameters": [],
	},
	"git_panel": {
		"dock": "right",
	},
	"show_edit_predictions": true,
	"ensure_final_newline_on_save": true,
	"wrap_guides": [80, 120],
	"hard_tabs": true,
	"tab_size": 2,
	"base_keymap": "VSCode",
	"preview_tabs": {
		"enable_preview_from_file_finder": false,
	},
	"minimap": {
		"show": "auto",
	},
	"vim_mode": true,
}
